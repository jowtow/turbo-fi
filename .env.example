# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.

# SQL Server SA password — used by the database service and the connection string below
MSSQL_SA_PASSWORD=

# Full ADO.NET connection string for the API to reach SQL Server
# When running via docker compose the host is the service name: "database"
ConnectionStrings__TurboFi=Server=database,1433;Database=TurboFi;User Id=sa;Password=CHANGEME;TrustServerCertificate=True

# Comma-separated list of allowed CORS origins for the API
# Set to the public URL your front-end is served from (e.g. https://turbofi.example.com)
CorsOrigins=http://localhost:5173
