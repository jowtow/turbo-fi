# ── Stage 1: Build the React front-end ────────────────────────────────────────
FROM node:22-alpine AS web-build
WORKDIR /app
COPY src/turbo-fi-web/package*.json ./
RUN npm ci
COPY src/turbo-fi-web/ .
RUN npm run build

# ── Stage 2: Build the .NET API ───────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api-build
WORKDIR /src
COPY ["src/TurboFi.Api/TurboFi.Api.csproj", "src/TurboFi.Api/"]
RUN dotnet restore "src/TurboFi.Api/TurboFi.Api.csproj"
COPY . .
RUN dotnet publish "src/TurboFi.Api/TurboFi.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# ── Stage 3: .NET ASP.NET Core runtime (copied from the official image) ───────
# Avoids apt package availability issues; the runtime files are self-contained.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS dotnet-runtime

# ── Stage 4: Runtime image — SQL Server + .NET runtime + nginx ────────────────
# NOTE: SQL Server on Linux requires x86_64 / arm64 (amd64 is the most tested).
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

# Base utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gnupg2 \
        ca-certificates \
        supervisor \
        nginx \
        cron \
    && rm -rf /var/lib/apt/lists/*

# Add the Microsoft package signing key and repositories
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] \
        https://packages.microsoft.com/ubuntu/22.04/mssql-server-2022 jammy main" \
        > /etc/apt/sources.list.d/mssql-server-2022.list \
    && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] \
        https://packages.microsoft.com/ubuntu/22.04/prod jammy main" \
        > /etc/apt/sources.list.d/microsoft-prod.list

# Install SQL Server and mssql-tools; also pull in .NET runtime's system-lib deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends mssql-server \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends \
        mssql-tools18 \
        unixodbc-dev \
    && apt-get install -y --no-install-recommends \
        libicu70 \
        libssl3 \
        libgcc-s1 \
        libstdc++6 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Copy the .NET ASP.NET Core runtime directly from the official image
COPY --from=dotnet-runtime /usr/share/dotnet /usr/share/dotnet
RUN ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet

ENV PATH="$PATH:/opt/mssql-tools18/bin"

# Remove the default nginx site so our config is the only one active
RUN rm -f /etc/nginx/sites-enabled/default

# Copy built artifacts from earlier stages
COPY --from=web-build /app/dist /usr/share/nginx/html
COPY --from=api-build /app/publish /app/api

# Copy standalone runtime configuration
COPY docker/nginx-standalone.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisord.conf      /etc/supervisor/conf.d/turbofi.conf
COPY docker/entrypoint.sh         /entrypoint.sh
COPY docker/wait-for-mssql.sh     /app/wait-for-mssql.sh
COPY docker/backup.sh             /app/backup.sh
RUN chmod +x /entrypoint.sh /app/wait-for-mssql.sh /app/backup.sh

# Mount your SQL Server data directory here to persist all database files
VOLUME ["/var/opt/mssql"]
# Mount this to retrieve backup .bak files from the host
VOLUME ["/backups"]

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
